{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=StudentGradeManagementDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "StudentGrades.Api",
    "Audience": "StudentGrades.Clients",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7090", "http://localhost:5090" ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "SeedUsers": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
