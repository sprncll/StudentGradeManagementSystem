@model DashboardViewModel
@{
    ViewData["Title"] = "My Grades";
}
<div id="api-config" data-api-base="@Model.ApiBaseUrl" data-token="@Model.AccessToken" hidden></div>

<div class="mb-3">
    <h1 class="h3 mb-0">My Grades</h1>
    @* Name and student number are filled from GET /api/student/me *@
    <div class="text-muted" id="student-info">
        <span id="student-name">@Model.DisplayName</span>
        <span id="student-number-wrap">· Student No. <strong id="student-number">@Model.Number</strong></span>
    </div>
</div>

<div id="alert-area" aria-live="polite"></div>

<div class="row g-3 mb-3" id="summary" hidden>
    <div class="col-sm-4">
        <div class="card shadow-sm stat-tile">
            <div class="card-body py-2">
                <div class="small text-muted">Subjects</div><div class="h4 mb-0" id="sum-count">0</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card shadow-sm stat-tile">
            <div class="card-body py-2">
                <div class="small text-muted">Average grade</div><div class="h4 mb-0" id="sum-average">–</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card shadow-sm stat-tile">
            <div class="card-body py-2">
                <div class="small text-muted">Failed (BEP)</div><div class="h4 mb-0" id="sum-failed">0</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subject Code</th>
                        <th>Subject</th>
                        <th class="text-center">Grade</th>
                        <th>Remarks</th>
                        <th>Semester</th>
                        <th>School Year</th>
                        <th>Instructor</th>
                    </tr>
                </thead>
                <tbody id="grades-body">
                    <tr><td colspan="7" class="text-center text-muted py-4">Loading your grades…</td></tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="small text-muted" id="last-loaded"></span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="btn-refresh">Refresh</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-client.js" asp-append-version="true"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>
}