@model DashboardViewModel
@{
    ViewData["Title"] = "My Grades";
}
<div id="api-config" data-api-base="@Model.ApiBaseUrl" data-token="@Model.AccessToken" hidden></div>

<div class="hero mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="hero-avatar"><img src="~/images/tiger.jpg" alt="" asp-append-version="true" /></span>
            <div>
                <div class="eyebrow">Student</div>
                <h1 class="h3">My Grades</h1>
                @* Name and student number are filled from GET /api/student/me *@
                <div class="hero-sub" id="student-info">
                    <span id="student-name">@Model.DisplayName</span>
                    <span id="student-number-wrap">· Student No. <strong id="student-number">@Model.Number</strong></span>
                </div>
                <span class="standing-pill" id="standing" hidden></span>
            </div>
        </div>
        <div class="d-flex gap-2 no-print">
            <button type="button" class="btn btn-outline-light" id="btn-print">Print</button>
            <button type="button" class="btn btn-gold" id="btn-refresh">Refresh</button>
        </div>
    </div>
</div>

<div id="alert-area" aria-live="polite"></div>

<div class="row g-3 mb-4" id="summary" hidden>
    <div class="col-6 col-lg-3"><div class="stat-card is-dark">
        <div class="stat-label">Subjects</div><div class="stat-value" id="sum-count">0</div>
    </div></div>
    <div class="col-6 col-lg-3"><div class="stat-card">
        <div class="stat-label">Average grade</div><div class="stat-value" id="sum-average">–</div>
    </div></div>
    <div class="col-6 col-lg-3"><div class="stat-card">
        <div class="stat-label">Highest grade</div><div class="stat-value" id="sum-high">–</div>
    </div></div>
    <div class="col-6 col-lg-3"><div class="stat-card">
        <div class="stat-label">Failed (BEP)</div><div class="stat-value" id="sum-failed">0</div>
    </div></div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row g-2 align-items-center mb-3 no-print">
            <div class="col-lg-7">
                <div class="d-flex flex-wrap gap-2" id="term-chips" role="group" aria-label="Filter by term"></div>
            </div>
            <div class="col-lg-5">
                <input type="search" id="grade-search" class="form-control" aria-label="Search subjects" placeholder="Search subject or instructor" autocomplete="off" />
            </div>
        </div>

        <div class="table-shell">
            <div class="table-responsive">
                <table class="table table-hover align-middle ust-table">
                    <thead id="grades-head">
                        <tr>
                            <th data-col="subject" aria-sort="none"><button type="button" class="th-btn" data-sort="subject">Subject Code</button></th>
                            <th>Subject</th>
                            <th class="text-center" data-col="grade" aria-sort="none"><button type="button" class="th-btn" data-sort="grade">Grade</button></th>
                            <th>Remarks</th>
                            <th data-col="term" aria-sort="none"><button type="button" class="th-btn" data-sort="term">Semester</button></th>
                            <th>School Year</th>
                            <th>Instructor</th>
                        </tr>
                    </thead>
                    <tbody id="grades-body">
                        <tr><td colspan="7" class="text-center text-muted py-4">Loading your grades…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="small text-muted" id="result-count"></span>
            <span class="small text-muted" id="last-loaded"></span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-client.js" asp-append-version="true"></script>
    <script src="~/js/student-dashboard.js" asp-append-version="true"></script>
}