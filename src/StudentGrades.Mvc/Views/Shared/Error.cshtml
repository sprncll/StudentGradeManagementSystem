@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 text-danger">Error @Model.StatusCode</h1>
                <p class="mb-3">@Model.Message</p>
                @if (!string.IsNullOrEmpty(Model.RequestId))
                {
                    <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
                }
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to my dashboard</a>
            </div>
        </div>
    </div>
</div>
