<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/ust-seal.png" />
    <title>@ViewData["Title"] - Student Grade Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#main">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-sm ust-nav mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/ust-seal.png" alt="UST Angelicum College seal" class="brand-seal" asp-append-version="true" />
                    <span class="brand-text">Student Grade Management<small>UST Angelicum College</small></span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <span class="user-chip">
                            <span>@User.Identity.Name</span>
                            <span class="role-pill">@(User.IsInRole(AppRoles.Faculty) ? "Faculty" : "Student")</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-sm btn-signout">Sign out</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main id="main" class="container pb-5">
        @RenderBody()
    </main>

    <footer class="ust-footer py-3 small">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><strong>UST Angelicum College</strong> &middot; Student Grade Management System</span>
            <span>Web Systems and Technologies &middot; Final Practical Examination</span>
        </div>
    </footer>

    <div id="toast-area" aria-live="polite"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>