@model DashboardViewModel
@{
    ViewData["Title"] = "Faculty Dashboard";
}
@* The API URL and the signed-in user's JWT are handed to the JavaScript through data-* attributes. *@
<div id="api-config" data-api-base="@Model.ApiBaseUrl" data-token="@Model.AccessToken" hidden></div>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Faculty Dashboard</h1>
        <div class="text-muted">@Model.DisplayName @(string.IsNullOrEmpty(Model.Number) ? "" : $"· {Model.Number}")</div>
    </div>
    <button type="button" class="btn btn-primary" id="btn-add">+ Add grade</button>
</div>

<div id="alert-area" aria-live="polite"></div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="filter-form" class="row g-2 mb-3" autocomplete="off">
            <div class="col-md-5">
                <input type="search" id="filter-search" class="form-control" placeholder="Search student no., name or subject" />
            </div>
            <div class="col-md-3">
                <select id="filter-semester" class="form-select">
                    <option value="">All semesters</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="text" id="filter-year" class="form-control" placeholder="School year e.g. 2026-2027" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Subject</th>
                        <th class="text-center">Grade</th>
                        <th>Remarks</th>
                        <th>Semester</th>
                        <th>School Year</th>
                        <th>Posted / Modified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="grades-body">
                    <tr><td colspan="8" class="text-center text-muted py-4">Loading grade records…</td></tr>
                </tbody>
            </table>
        </div>
        <div id="grades-count" class="small text-muted mt-2"></div>
    </div>
</div>

<!-- Add / Edit modal -->
<div class="modal fade" id="grade-modal" tabindex="-1" aria-labelledby="grade-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="grade-form" novalidate autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title h5" id="grade-modal-title">Add grade</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="form-alert" aria-live="polite"></div>
                <input type="hidden" id="grade-id" />
                <div class="row g-3">
                    <div class="col-md-12">
                        <label for="f-studentId" class="form-label">Student</label>
                        <select id="f-studentId" name="studentId" class="form-select" required>
                            <option value="">Select a student…</option>
                        </select>
                        <div class="invalid-feedback" data-for="StudentId"></div>
                    </div>
                    <div class="col-md-4">
                        <label for="f-subjectCode" class="form-label">Subject code</label>
                        <input id="f-subjectCode" name="subjectCode" class="form-control text-uppercase" maxlength="30" required />
                        <div class="invalid-feedback" data-for="SubjectCode"></div>
                    </div>
                    <div class="col-md-8">
                        <label for="f-subjectName" class="form-label">Subject name</label>
                        <input id="f-subjectName" name="subjectName" class="form-control" maxlength="200" required />
                        <div class="invalid-feedback" data-for="SubjectName"></div>
                    </div>
                    <div class="col-md-4">
                        <label for="f-grade" class="form-label">Grade (0–100, whole number)</label>
                        <input id="f-grade" name="grade" type="number" min="0" max="100" step="1" class="form-control" required />
                        <div class="invalid-feedback" data-for="Grade"></div>
                    </div>
                    <div class="col-md-4">
                        <label for="f-semester" class="form-label">Semester</label>
                        <select id="f-semester" name="semester" class="form-select" required></select>
                        <div class="invalid-feedback" data-for="Semester"></div>
                    </div>
                    <div class="col-md-4">
                        <label for="f-schoolYear" class="form-label">School year</label>
                        <input id="f-schoolYear" name="schoolYear" class="form-control" placeholder="2026-2027" required />
                        <div class="invalid-feedback" data-for="SchoolYear"></div>
                    </div>
                </div>
                <p class="form-text mt-3 mb-0">
                    Remarks are computed by the server from the grade (95–100 CMS, 90–94 SP, 85–89 SAP,
                    80–84 GP, 75–79 EP, 0–74 BEP/FAILED) and cannot be entered here.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="btn-save">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/api-client.js" asp-append-version="true"></script>
    <script src="~/js/faculty-dashboard.js" asp-append-version="true"></script>
}
