@{
    ViewData["Title"] = "Access denied";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-warning">
            <h1 class="h5">Access denied (403)</h1>
            <p class="mb-2">Your account is signed in but does not have permission to open that page.</p>
            <a class="btn btn-sm btn-primary" asp-controller="Home" asp-action="Index">Go to my dashboard</a>
        </div>
    </div>
</div>
