@{
    ViewData["Title"] = "Access denied";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4 text-center">
                <div class="empty-icon brand-mark mb-3" style="width:3.5rem;height:3.5rem;font-size:1.4rem">!</div>
                <h1 class="h4">Access denied (403)</h1>
                <p class="text-muted">Your account is signed in but does not have permission to open that page.</p>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to my dashboard</a>
            </div>
        </div>
    </div>
</div>